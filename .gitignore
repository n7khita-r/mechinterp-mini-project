*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
paper/*.pdf
presentation/*.pdf

# Run logs: machine-specific, and they contain host and path details
logs/

