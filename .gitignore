# Results: commit the findings (JSON), not the intermediates.
# Every .pt here -- mean activations, AIE grids, the function vectors themselves
# -- is regenerable from the JSON plus the configs, and they are hundreds of MB.
results/cache/
*.pt
results/**/*.npz

# Model weights / HF cache if anyone points it here
models/
*.safetensors
*.bin

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# SLURM logs
slurm-*.out
slurm_logs/

